[0.230, "o", "\u001b[1;32m$\u001b[0m bashy --version\r\n"]
[1.251, "o", "bashy, GNU Bash 5.3 compatible, version 5.3.0(1)-bashy-0.23.0\r\n"]
[1.508, "o", "\u001b[1;32m$\u001b[0m sed -n '19,32p' 00-quickstart/judge.bsh      # one agentic function under three contracts\r\n"]
[1.211, "o", "@guard(effects: \"read\")\r\n@require('test -n \"$1\"')\r\n@ensure('test \"$1\" != lie')\r\nagentic function summarize() {\r\n    echo \"body: $1\"\r\n    case \"$1\" in\r\n    write) touch \"$work/leak\" ;;    # exceeds the read cap -> denied, status 1\r\n    yield) return 6 ;;              # input required -- a yield, not a result\r\n    fail)  return 1 ;;\r\n    esac                            # \"lie\": exits 0, the postcondition disagrees\r\n}\r\n\r\nagentic {\r\n    summarize ok;      echo \"ok      -> $?\"\r\n"]
[4.006, "o", "\u001b[1;32m$\u001b[0m bashy --bashsharp 00-quickstart/judge.bsh    # six calls, six exit codes\r\n"]
[1.234, "o", "body: ok\r\n"]
[0.000, "o", "ok      -> 0\r\n"]
[0.000, "o", "summarize: precondition failed: test -n \"$1\"\r\nempty   -> 3\r\n"]
[0.000, "o", "body: lie\r\n"]
[0.000, "o", "summarize: postcondition failed: test \"$1\" != lie\r\nlie     -> 3\r\n"]
[0.000, "o", "body: write\r\n"]
[0.000, "o", "write   -> 1\r\n"]
[0.000, "o", "body: fail\r\n"]
[0.000, "o", "fail    -> 1\r\n"]
[0.000, "o", "body: yield\r\n"]
[0.000, "o", "yield   -> 6\r\n"]
[5.008, "o", "\u001b[1;32m$\u001b[0m # 0 ok · 3 require failed · 3 ensure disagreed · 1 write denied · 1 fail · 6 = YIELD: 'I need input'\r\n"]
[3.222, "o", "\u001b[1;32m$\u001b[0m # the interpreter never called a model. that is the point.\r\n"]
