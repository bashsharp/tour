#!/usr/bin/env -S bashy --bashsharp
# A script that carries its own CI/CD. The fence is a dag — bashy's task
# language, the same file `bashy dag` runs — and its targets are the alias's
# methods (the row answers `methods` from the dag's own target list). A
# target's `Effects:` line is the method's declared effect, so a @guard that
# does not allow it denies the call with status 126, exactly as @effects on
# a function would. The dag runs in this script's directory.

export PIPELINE=$0

~~~dag as ci
---
name: pipeline
---
## Tasks

### lint
Count the lines of this script.
Effects: read
```bash
wc -l < "$PIPELINE" | tr -d ' '
```

### package
Pretend to publish.
Effects: read, net
```bash
echo "published a $(wc -l < "$PIPELINE" | tr -d ' ')-line script"
```
~~~

lines := ci.lint()
echo "lint: $lines lines"

@guard("read")
func rehearse() {
  x := ci.package()
  echo "rehearsal: status=$? (a guard without net denies package)"
}
rehearse()

out := ci.package()
echo "$out"
