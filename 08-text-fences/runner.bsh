#!/usr/bin/env -S bashy --bashsharp
# A text fence: the body is not code but an artifact — here a KEY=value config
# for a tool bashy has no row for — and the alias exposes the verbs of the
# PROCESSOR, not functions parsed from the body. `!env-runner` names the
# processor (a shell function declared in this file); it is called as
# `runner <verb> <materialized-file> [args…]`, and its `methods` answer is the
# alias's whole export set — nothing is guessed. `apply` declares `write`, so
# a read-only @guard denies it with status 126 before it runs. The rendered
# file lands beside the fence body in bashy's cache, never in this directory.

env-runner() {
  case "$1" in
    methods) printf '%s\n' '{"name":"show"}' '{"name":"apply","effects":["write"]}' ;;
    show)    grep -v '^#' "$2" | sort ;;
    apply)   out="${2%[/\\]*}/rendered.env"; grep -v '^#' "$2" | sort > "$out"; echo "$out" ;;
  esac
}

~~~env as cfg !env-runner
# the deployment knobs
REGION=eu-west
REPLICAS=3
~~~

knobs := cfg.show()
echo "$knobs"

@guard("read")
func rehearse() {
  x := cfg.apply()
  echo "rehearsal: status=$? (write is not in the guard)"
}
rehearse()

rendered := cfg.apply()
echo "applied -> ${rendered##*/}"
