#!/usr/bin/env -S bashy --bashsharp
# A language bashy has no fence for — awk — through a runner REGISTERED as a
# command (07-commands) instead of declared in the file that uses it. A
# runner is resolved as a function of the unit, then as a registered command,
# then refused: a program that merely sits on PATH is never a runner, so a
# fence means the same thing on every host. Registration is seen by the next
# shell, so this file registers and then runs words.bsh, which names the
# runner and declares nothing else. The ring is a scratch one, as in
# 07-commands, so nothing of yours is touched.

export BASHY_COMMANDS_DIR=$(mktemp -d)
trap 'rm -rf "$BASHY_COMMANDS_DIR"' EXIT

bashy --bashsharp words.bsh 2>&1 | head -1     # before: refused, PATH is never consulted
echo "before -> refused"

bashy commands add awk-runner --set effects.0=exec \
    --set synopsis="a fence runner for awk: methods | run FILE [args] | check FILE" \
    --set script='
case "$1" in
  methods) printf "%s\n" "{\"name\":\"run\",\"effects\":[\"exec\"]}" "{\"name\":\"check\"}" ;;
  run)     file=$2; shift 2; awk -f "$file" "$@" ;;
  check)   awk -f "$2" </dev/null >/dev/null 2>&1 && echo "awk: ok" ;;
esac'

bashy --bashsharp words.bsh;                 echo "after  -> $?"
