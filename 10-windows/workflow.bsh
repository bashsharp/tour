#!/usr/bin/env -S bashy --bashsharp
# Bash# first: this program owns the control flow, the pipe and the
# contract. PowerShell shapes text the Windows way; C# computes with a .NET
# library. Neither is installed on this machine: bashy provisions its pinned
# PowerShell 7 runtime on first use. The same file runs unchanged on
# Windows, Linux and macOS. (Do not write a tilde fence inside a comment —
# the scanner would take it for a real one.)

~~~powershell as ps
function Shout([string]$s) {
  return $s.ToUpper() + "!"
}
function Bracket {
  process { "[$_]" }
}
~~~

~~~csharp as cs
using System;
using System.Linq;

public static long Add(long a, long b) => a + b;
public static string Seq(string sep, long n) => string.Join(sep, Enumerable.Range(1, (int)n));
~~~

@ensure('test -n "$RESULT"')
func headline(title string) string {
  return "== $title =="
}

h := headline("report")
echo "$h"

total := cs.Add(20, 22)
echo "total=$total"

seq := cs.Seq("-", 3)
echo "seq=$seq"

shouted, serr := ps.Shout("fences travel")
echo "$shouted"

printf 'gamma\nalpha\nbeta\n' | ps.Bracket | sort

if test "$total" -eq 42; then
  echo "total checks out"
fi
