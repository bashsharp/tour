#!/usr/bin/env -S bashy --bashsharp
embed tool "./fixtures/tool.yaml" as oracle

@guard(effects: "read,exec,net,spend")
@ensure('test "$RESULT" = "recorded answer"')
agentic func query() string {
  answer, err := oracle.review("Return the recorded answer")
  return answer
}
agentic { answer := query(); echo "$answer"; }
