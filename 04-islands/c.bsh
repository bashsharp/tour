#!/usr/bin/env -S bashy --bashsharp
# A C island: plain C functions with C types; needs clang on PATH (the
# island is analysed through Clang's AST — a GCC cc cannot serve it).

~~~c as c
#include <string.h>
int add(int a, int b) { return a + b; }
size_t length(const char *s) { return strlen(s); }
~~~

x := c.add(20, 22)
echo "x=$x"
n := c.length("island")
echo "n=$n"
