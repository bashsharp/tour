#!/usr/bin/env -S bashy --bashsharp
# A script that carries its CMakeLists.txt. The row configures with
# `-S <fence dir> -B <fence root>/build`, so the build tree is under bashy's
# cache and the fenced file names its sources as ${BASHPP_CWD}/… — this
# directory.
cd "$(dirname "$0")"

~~~cmake as cm
cmake_minimum_required(VERSION 3.20)
project(fenced C)
add_executable(app ${BASHPP_CWD}/main.c)
add_custom_target(test COMMAND app)
~~~

cm.configure();                 echo "configure -> $?"
cm.build();                     echo "build -> $?"
out := cm.test()
echo "test -> $? ($(printf '%s\n' "$out" | tail -1))"
