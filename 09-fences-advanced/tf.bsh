#!/usr/bin/env -S bashy --bashsharp
# Infrastructure as a fence. The body is an OpenTofu module — locals and an
# output, no provider, so every verb here works offline — and the alias
# exposes tofu's verbs with their effects: validate and output are free,
# init and plan reach the network, apply and destroy change the world (and
# may spend money), so a @guard without those atoms denies them with 126
# before tofu is asked. apply is only ever REHEARSED here. bashy provisions
# tofu itself (a pinned, checksum-verified release; MPL-2.0), never from PATH.

~~~tf as iac
locals {
  region   = "eu-west"
  replicas = 3
}

output "summary" {
  value = "${local.replicas} replicas in ${local.region}"
}
~~~

v := iac.validate();   echo "validate -> $?"
i := iac.init();       echo "init     -> $?"
p := iac.plan();       echo "plan     -> $?"
echo "$p" | grep summary

@guard("read,net")
func rehearse() {
  x := iac.apply()
  echo "apply under read,net -> $? (write and spend are not in the guard)"
}
rehearse()

o := iac.output();     echo "output   -> $? (nothing was applied, so no state and no outputs)"
